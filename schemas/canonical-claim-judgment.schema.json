{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://state-system.local/schemas/canonical-claim-judgment.schema.json",
  "title": "CanonicalClaimJudgment",
  "description": "Model-owned semantic judgment for a canonical claim. Code may validate and persist this shape, but must not infer the judgment.",
  "type": "object",
  "required": [
    "claim_id",
    "judgment",
    "rationale",
    "confidence",
    "newer_evidence_refs",
    "reviewed_at"
  ],
  "additionalProperties": false,
  "properties": {
    "claim_id": { "type": "string" },
    "judgment": {
      "type": "string",
      "enum": ["still_holds", "drifted", "superseded", "uncertain"]
    },
    "rationale": { "type": "string" },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "newer_evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
